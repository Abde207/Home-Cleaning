# Local development only. Copy to ignored .env and replace every placeholder.
# Staging/production values are injected by their runtime secret store, never copied from this file.
NODE_ENV=development
# APP_ENVIRONMENT=development (optional locally; required for staging)
PORT=3001
# HOST=127.0.0.1 (local default; required for staging/production)
DATABASE_URL=postgresql://homeclean:replace-me@127.0.0.1:55432/homeclean?schema=public
REDIS_URL=redis://127.0.0.1:56379
POSTGRES_USER=homeclean
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=homeclean
CORS_ORIGINS=http://localhost:3000
# Server-only Admin BFF target. Never expose this through NEXT_PUBLIC_*.
BACKEND_API_URL=http://127.0.0.1:3001/api/v1
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_DELIVERY_MODE=file
# file is local development/test only. A real provider is a later Phase 15 decision.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional Dispatch policy tuning (defaults are validated in dispatch.config.ts).
# DISPATCH_WEIGHTS_JSON={"availability":1,"service":1,"capability":1,"proximity":3,"workload":2,"reliability":1,"performance":1}
# DISPATCH_OFFER_SECONDS=600
# DISPATCH_MAX_ATTEMPTS=3
# DISPATCH_TRAVEL_KPH=30
# DISPATCH_LOCATION_MAX_AGE_MINUTES=120
# DISPATCH_WORKER_ENABLED=true
# Mock adapter is local/staging-only and must never accept production traffic.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-payment-webhook-characters
# DISPATCH_WORKER_ENABLED=true
# NOTIFICATION_WORKER_ENABLED=true
